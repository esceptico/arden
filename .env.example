# ── LLM provider keys (at least one required) ────────────────────────
# Arden auto-selects models based on the provider key you set.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# or add custom models via ~/.arden/models.json
# OPENROUTER_API_KEY=sk-or-...

# ── Model overrides (optional — auto-detected from provider key) ─────
# ARDEN_CHAT_MODEL=claude-sonnet-4-6
# ARDEN_MEMORY_MODEL=gemini-3-flash-preview
# ARDEN_RESEARCH_MODEL=gemini-3-flash-preview
# ARDEN_EMBEDDING_MODEL=text-embedding-3-small

# ── Optional integrations ────────────────────────────────────────────
# Exa.ai web search
# EXA_API_KEY=...
# WEB_SEARCH=auto  # auto|exa|ddgs|none

# Telegram notifications
# TELEGRAM_BOT_TOKEN=...

# Browser history (chrome, safari, arc)
# ARDEN_BROWSER=chrome
# ARDEN_BROWSER_DAYS=30

# Judgment tracing (https://docs.judgmentlabs.ai)
# JUDGMENT_API_KEY=
# JUDGMENT_ORG_ID=72c1115e-e346-46f5-9982-0fc4bf761147

# Gmail & Calendar (requires Google OAuth setup)
# ARDEN_GMAIL=true
# ARDEN_CALENDAR=true

# ── API auth ──────────────────────────────────────────────────────────
# API key is auto-generated on first `arden-server serve` and printed once.
# Use `arden-server serve --reset-key` to regenerate.
