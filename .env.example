# Copy this file to .env and set at least one provider key.

# LLM providers
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Optional direct model selection. Configure role-specific models in Desktop Settings.
# ARDEN_CHAT_MODEL=
# ARDEN_EMBEDDING_MODEL=

# Search and notifications
# EXA_API_KEY=
# WEB_SEARCH=auto
# TELEGRAM_BOT_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_USER_TOKEN=

# Optional Judgment tracing
# JUDGMENT_API_KEY=
# JUDGMENT_ORG_ID=

# Local timezone used by memory and automations
# TZ=UTC

# The server API key is generated on first start and printed once.
# Regenerate it with: uv run --project apps/server arden-server serve --reset-key

# Docker: host port published by Compose; the container listens on 6877.
# ARDEN_PORT=6877
